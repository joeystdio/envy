<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "envy-app": Envy's own executables, signed before the installer packs them.
  The workflow uploads just these files (as a ZIP); everything else in the app folder is Microsoft's and already signed.
  ${version} is the release version (1.2.0), which the workflow passes as a parameter.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Envy.exe" product-name="Envy" product-version="${version}">
      <authenticode-sign/>
    </pe-file>
    <pe-file path="Envy.dll" product-name="Envy" product-version="${version}">
      <authenticode-sign/>
    </pe-file>
    <pe-file path="Envy.Core.dll" product-name="Envy" product-version="${version}">
      <authenticode-sign/>
    </pe-file>
    <pe-file path="cli/envy.exe" product-name="Envy" product-version="${version}">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
