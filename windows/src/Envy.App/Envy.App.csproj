<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The WinUI 3 app: window, system tray icon, dialogs and the Setup Assistant. Unpackaged and self-contained, so the
    per-user installer needs neither admin rights nor a signed MSIX. The UI is written in C# without XAML files.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Envy.App</RootNamespace>
    <AssemblyName>Envy</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Envy.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <EnableDefaultPriItems>false</EnableDefaultPriItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Trimming and single-file break WinUI's runtime type lookup. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <!-- MakePri.exe and mt.exe only run on Windows; building elsewhere is for compile checks only. -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Envy.Core\Envy.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Envy.ico" CopyToOutputDirectory="PreserveNewest" />
    <PRIResource Include="Strings\en-US\Resources.resw" />
  </ItemGroup>
</Project>
